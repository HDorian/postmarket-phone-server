#!/bin/sh
# Keep the phone's console display always on (headless shelf server) — disable blanking.
for t in /dev/tty1 /dev/console; do
  printf '\033[9;0]\033[13]' > "$t" 2>/dev/null || true   # blank-timer=0 + unblank now
done
echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null || true
command -v setterm >/dev/null 2>&1 && setterm --blank 0 --powerdown 0 --powersave off </dev/tty1 >/dev/tty1 2>/dev/null || true
exit 0
